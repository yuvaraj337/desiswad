# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Cashfree one-time payments
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Firebase Admin service account JSON for Cashfree webhook -> Firestore
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated Firebase Auth email addresses allowed to use /admin.
# The server assigns the Firestore custom claim { admin: true } on successful admin login.
ADMIN_EMAILS=
